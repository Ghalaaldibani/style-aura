rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Private user data: profile + items, outfits, favorites, events, interactionLogs
    match /users/{uid} {
      allow read, write: if isMe(uid);
      match /{subcollection=**} {
        allow read, write: if isMe(uid);
      }
    }

    // Small public card (name, style, email in lower case) used to find friends.
    // Anyone signed in can read ONE card at a time, so the list of users cannot be downloaded.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 1;
      allow write: if isMe(uid);
    }

    // Friend requests: document id = the two user ids sorted and joined with "_"
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.requestedBy == request.auth.uid
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && request.resource.data.status == 'pending'
        && id == request.resource.data.users[0] + '_' + request.resource.data.users[1];
      // Only the person who RECEIVED the request can accept it.
      allow update: if signedIn()
        && request.auth.uid in resource.data.users
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.users == resource.data.users;
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // Shared outfits
    function canReadPost(post) {
      return signedIn() && (post.audience == 'public' || request.auth.uid in post.visibleTo);
    }

    match /posts/{postId} {
      allow read: if canReadPost(resource.data);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.audience in ['friends', 'public']
        && request.auth.uid in request.resource.data.visibleTo
        && request.resource.data.caption.size() <= 200;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // One rating per user (document id = user id), value 1–5
      match /ratings/{uid} {
        allow read: if canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow write: if isMe(uid)
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data)
          && request.resource.data.value is int
          && request.resource.data.value >= 1
          && request.resource.data.value <= 5;
      }

      // Comments: anyone who can see the post; delete own comment (or the post owner can)
      match /comments/{commentId} {
        allow read: if canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid
              || get(/databases/$(database)/documents/posts/$(postId)).data.ownerId == request.auth.uid);
      }
    }
  }
}
